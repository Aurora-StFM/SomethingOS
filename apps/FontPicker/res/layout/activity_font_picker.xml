<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="24dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <!-- The two options side by side. Selecting an option selects its card and label. -->
    <LinearLayout
        android:id="@+id/options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/option_roboto"
            style="@style/FontOption"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/font_roboto">

            <TextView
                style="@style/FontCardPreview"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/FontCardLabel"
                android:fontFamily="sans-serif"
                android:text="@string/font_roboto" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/option_geist"
            style="@style/FontOption"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/font_geist">

            <TextView
                style="@style/FontCardPreview"
                android:fontFamily="somethingos-sans"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/FontCardLabel"
                android:fontFamily="somethingos-sans"
                android:text="@string/font_geist" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shown instead of the options after Apply. -->
    <TextView
        android:id="@+id/restart_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="@string/restart_message"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Cancel / Apply (Later / Restart after Apply), at the bottom right. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancel"
            style="@style/PillButton"
            android:background="@drawable/button_cancel"
            android:text="@string/cancel"
            android:textColor="@color/cancel_text" />

        <TextView
            android:id="@+id/apply"
            style="@style/PillButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_apply"
            android:text="@string/apply"
            android:textColor="@color/apply_text" />
    </LinearLayout>
</LinearLayout>
