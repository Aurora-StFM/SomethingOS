<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.somethingos.fontpicker">

    <uses-permission android:name="android.permission.UPDATE_FONTS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_font"
        android:theme="@android:style/Theme.DeviceDefault.Settings"
        android:supportsRtl="true">

        <!-- Shown as an entry on Settings' Display page (a Settings "tile"). -->
        <activity
            android:name=".FontPickerActivity"
            android:label="@string/title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_font" />
        </activity>
    </application>
</manifest>
