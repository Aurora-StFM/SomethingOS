<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.somethingos.fontpicker">

    <uses-permission android:name="android.permission.UPDATE_FONTS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.REBOOT" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_font"
        android:supportsRtl="true">

        <!-- A dialog opened from Settings > Display > Font and display size >
             Default font (our packages_apps_Settings fork).
             assetsPaths: applying Roboto enables a font overlay, which would
             otherwise rebuild this dialog and lose the restart question. -->
        <activity
            android:name=".FontPickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="assetsPaths"
            android:theme="@style/Theme.FontPicker">
            <intent-filter>
                <action android:name="org.somethingos.fontpicker.action.PICK_FONT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
