<?xml version="1.0" encoding="UTF-8"?>
<!--
    Device manifest: Nothing Phone (1)
    Codename: Spacewar (A063)

    Use together with somethingos.xml. The device is officially supported by
    LineageOS; the vendor blobs come from TheMuppets, as for official builds.
-->
<manifest>
    <remote name="muppets" fetch="https://github.com/TheMuppets" />

    <project name="LineageOS/android_device_nothing_Spacewar"
             path="device/nothing/Spacewar"
             remote="github"
             revision="lineage-24.0" />

    <project name="LineageOS/android_kernel_nothing_sm7325"
             path="kernel/nothing/sm7325"
             remote="github"
             revision="lineage-24.0" />

    <project name="LineageOS/android_hardware_nothing"
             path="hardware/nothing"
             remote="github"
             revision="lineage-24.0" />

    <project name="proprietary_vendor_nothing_Spacewar"
             path="vendor/nothing/Spacewar"
             remote="muppets"
             revision="lineage-24.0" />
</manifest>
