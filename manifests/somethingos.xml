<?xml version="1.0" encoding="UTF-8"?>
<!--
    SomethingOS local manifest: the SomethingOS repositories shared by
    every device.

    Copy this file into .repo/local_manifests/ in a LineageOS 24.0 checkout,
    together with the manifest for your device (e.g. gta4xlveu.xml), then
    run `repo sync`. See README.md for the full steps.
-->
<manifest>
    <remote name="somethingos" fetch="https://github.com/Aurora-StFM" />

    <!-- SomethingOS vendor layer (this repository) -->
    <project name="SomethingOS"
             path="vendor/somethingos"
             remote="somethingos"
             revision="somethingos-24.0" />
</manifest>
